{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Video Sage",
  "version": "0.3.0",
  "identifier": "com.robmirabelle.videosage",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:14530",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "splash",
        "url": "splash.html",
        "title": "Video Sage",
        "width": 520,
        "height": 270,
        "resizable": false,
        "center": true,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "skipTaskbar": true,
        "dragDropEnabled": false,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "backgroundColor": "#262a34"
      },
      {
        "label": "main",
        "title": "Video Sage",
        "width": 1280,
        "height": 800,
        "minWidth": 800,
        "minHeight": 520,
        "visible": false,
        "decorations": false,
        "transparent": false,
        "shadow": true,
        "dragDropEnabled": true,
        "additionalBrowserArgs": "--disable-features=msWebOOUI,msPdfOOUI,msSmartScreenProtection",
        "backgroundColor": "#16181f"
      }
    ],
    "security": { "csp": null }
  },
  "bundle": {
    "active": true,
    "targets": ["nsis"],
    "icon": ["icons/icon.ico"],
    "resources": ["icons/icon.ico", "ffmpeg/ffmpeg.exe", "ffmpeg/ffprobe.exe", "ffmpeg/LICENSE.txt", "ffmpeg/SOURCE.txt"],
    "windows": {
      "nsis": {
        "template": "installer.nsi"
      }
    }
  }
}
